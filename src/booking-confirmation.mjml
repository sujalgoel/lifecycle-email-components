<mjml>
	<mj-head>
		<mj-title>Your booking is confirmed</mj-title>
		<mj-preview>Confirmed: {{event.property_name}}, {{event.check_in | date: "%b %-d"}} to {{event.check_out | date: "%b %-d"}}. Full breakdown inside.</mj-preview>
		<mj-attributes>
			<mj-all font-family="Georgia, 'Times New Roman', serif" />
			<mj-text font-size="16px" line-height="26px" color="#1f2a24" />
			<mj-section background-color="#ffffff" padding="0 32px" />
			<mj-class name="h1" font-size="26px" line-height="34px" font-weight="700" color="#14211b" />
			<mj-class name="meta" font-size="13px" line-height="20px" color="#5c6b62" />
			<mj-class name="btn" background-color="#1d5c45" color="#ffffff" font-size="16px" font-weight="700" inner-padding="16px 36px" border-radius="8px" />
		</mj-attributes>
		<mj-style>
			.price-table td { padding: 8px 0; font-size: 15px; color: #1f2a24; }
			.price-table .total td { padding-top: 14px; border-top: 1px solid #d8e0db; font-weight: 700; }
			.amount { text-align: right; }
			@media (prefers-color-scheme: dark) {
				.body-bg { background-color: #101513 !important; }
				.card { background-color: #1a221e !important; }
				.card h1, .card p, .card td { color: #e8ede9 !important; }
				.muted { color: #9fb0a6 !important; }
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#eef2ef" css-class="body-bg">
		<mj-section padding="28px 32px 12px">
			<mj-column>
				<mj-text mj-class="meta" align="center" letter-spacing="2px" text-transform="uppercase" font-family="Helvetica, Arial, sans-serif">Wavecrest Stays</mj-text>
			</mj-column>
		</mj-section>

		<mj-wrapper padding="0 16px 32px">
			<mj-section border-radius="12px" padding="36px 36px 8px" css-class="card">
				<mj-column>
					<mj-text mj-class="h1">You are booked, {{customer.first_name}}.</mj-text>
					<mj-text padding-top="8px">{{event.property_name}} is confirmed for {{event.guests}} guests, {{event.check_in | date: "%A %-d %B"}} to {{event.check_out | date: "%A %-d %B"}}. Confirmation number {{event.booking_id}}.</mj-text>
				</mj-column>
			</mj-section>

			<mj-section padding="8px 36px" css-class="card">
				<mj-column>
					<mj-table css-class="price-table">
						<tr><td>{{event.nights}} nights x {{event.nightly_rate | money}}</td><td class="amount">{{event.accommodation_total | money}}</td></tr>
						<tr><td>Cleaning fee</td><td class="amount">{{event.cleaning_fee | money}}</td></tr>
						<tr><td>Taxes</td><td class="amount">{{event.taxes | money}}</td></tr>
						<tr class="total"><td>Charged to your card</td><td class="amount">{{event.total | money}}</td></tr>
					</mj-table>
				</mj-column>
			</mj-section>

			<mj-section padding="12px 36px 40px" css-class="card">
				<mj-column>
					<mj-button mj-class="btn" href="{{event.manage_url}}" font-family="Helvetica, Arial, sans-serif">Manage your booking</mj-button>
					<mj-text mj-class="meta" css-class="muted" align="center" padding-top="14px">Check-in from 4pm. Door code arrives by text the morning of arrival.</mj-text>
				</mj-column>
			</mj-section>
		</mj-wrapper>

		<mj-section padding="0 32px 40px" background-color="transparent">
			<mj-column>
				<mj-text mj-class="meta" css-class="muted" align="center" font-family="Helvetica, Arial, sans-serif">
					Wavecrest Stays, 4012 Croatan Hwy, Nags Head NC<br />
					<a href="{% unsubscribe_url %}" style="color:#5c6b62;">Unsubscribe</a> from marketing email. Booking emails always send.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
