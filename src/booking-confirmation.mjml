<mjml>
	<mj-head>
		<mj-title>Your booking is confirmed</mj-title>
		<mj-preview>Confirmed: {{event.property_name}}, {{event.check_in | date: "%b %-d"}} to {{event.check_out | date: "%b %-d"}}. Full breakdown inside.</mj-preview>
		<mj-attributes>
			<mj-all font-family="Georgia, 'Times New Roman', serif" />
			<mj-text font-size="16px" line-height="26px" color="#212b25" padding="0" />
			<mj-section padding="0" />
			<mj-class name="kicker" font-family="Helvetica, Arial, sans-serif" font-size="11px" line-height="16px" font-weight="700" letter-spacing="2.5px" text-transform="uppercase" color="#1a5a43" />
			<mj-class name="h1" font-size="30px" line-height="38px" font-weight="400" color="#1a251f" />
			<mj-class name="meta" font-family="Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#5d6c62" />
			<mj-class name="btn" background-color="#1a5a43" color="#f4f9f5" font-family="Helvetica, Arial, sans-serif" font-size="16px" font-weight="700" letter-spacing="0.25px" inner-padding="16px 24px" border-radius="10px" width="100%" padding="40px 0 0" />
		</mj-attributes>
		<mj-style>
			@media (prefers-color-scheme: dark) {
				html, body { background-color: #0e1411 !important; }
				.body-bg, .body-bg table, .body-bg td { background-color: #0e1411 !important; }
				.card, .card table, .card td { background-color: #19231c !important; }
				.btn table td { background-color: #35755a !important; }
				.btn a { background-color: #35755a !important; color: #eef5ef !important; }
				.card div, .card td { color: #e7ede8 !important; }
				.kicker div { color: #8ec3a4 !important; }
				.muted div { color: #9bae9f !important; }
				td.pr { border-bottom-color: #2c382f !important; }
				td.pt { border-top-color: #578f72 !important; }
				.wm div { color: #8ec3a4 !important; }
				.footer div, .footer a { color: #8fa295 !important; }
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#e9efe9" css-class="body-bg" width="640px">
		<mj-section padding="40px 32px 24px">
			<mj-column>
				<mj-text css-class="wm" align="center" font-size="14px" line-height="20px" letter-spacing="3px" text-transform="uppercase" color="#1a5a43">Wavecrest Stays</mj-text>
			</mj-column>
		</mj-section>

		<mj-wrapper padding="0 16px">
			<mj-section css-class="card" background-color="#fbfbf7" border-radius="16px" padding="48px 40px">
				<mj-column padding="0">
					<mj-text mj-class="kicker" css-class="kicker">Booking confirmed</mj-text>
					<mj-text mj-class="h1" padding="16px 0 0">You are booked, {{customer.first_name}}.</mj-text>
					<mj-text padding="16px 0 0">{{event.property_name}} is confirmed for {{event.guests}} guests, {{event.check_in | date: "%A %-d %B"}} to {{event.check_out | date: "%A %-d %B"}}. Confirmation number {{event.booking_id}}.</mj-text>
					<mj-table cellpadding="0" cellspacing="0" padding="32px 0 0">
						<tr>
							<td class="pr" style="padding: 12px 0; border-bottom: 1px solid #e2e9e3; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25;">{{event.nights}} nights x {{event.nightly_rate | money}}</td>
							<td class="pr" align="right" style="padding: 12px 0 12px 16px; border-bottom: 1px solid #e2e9e3; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25; text-align: right; white-space: nowrap;">{{event.accommodation_total | money}}</td>
						</tr>
						<tr>
							<td class="pr" style="padding: 12px 0; border-bottom: 1px solid #e2e9e3; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25;">Cleaning fee</td>
							<td class="pr" align="right" style="padding: 12px 0 12px 16px; border-bottom: 1px solid #e2e9e3; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25; text-align: right; white-space: nowrap;">{{event.cleaning_fee | money}}</td>
						</tr>
						<tr>
							<td style="padding: 12px 0 16px; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25;">Taxes</td>
							<td align="right" style="padding: 12px 0 16px 16px; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 22px; color: #212b25; text-align: right; white-space: nowrap;">{{event.taxes | money}}</td>
						</tr>
						<tr>
							<td class="pt" style="padding: 16px 0 0; border-top: 1px solid #1a5a43; font-family: Georgia, 'Times New Roman', serif; font-size: 17px; line-height: 24px; font-weight: 700; color: #1a251f;">Charged to your card</td>
							<td class="pt" align="right" style="padding: 16px 0 0 16px; border-top: 1px solid #1a5a43; font-family: Georgia, 'Times New Roman', serif; font-size: 17px; line-height: 24px; font-weight: 700; color: #1a251f; text-align: right; white-space: nowrap;">{{event.total | money}}</td>
						</tr>
					</mj-table>
					<mj-button mj-class="btn" css-class="btn" href="{{event.manage_url}}">Manage your booking</mj-button>
					<mj-text mj-class="meta" css-class="muted" align="center" padding="16px 0 0">Check-in from 4pm. Door code arrives by text the morning of arrival.</mj-text>
				</mj-column>
			</mj-section>
		</mj-wrapper>

		<mj-section padding="32px 32px 48px">
			<mj-column>
				<mj-text mj-class="meta" css-class="footer" align="center" font-size="12px">
					Wavecrest Stays, 4012 Croatan Hwy, Nags Head NC<br />
					<a href="{% unsubscribe_url %}" style="color: #5d6c62;">Unsubscribe</a> from marketing email. Booking emails always send.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
